// Cloudflare Workers static assets: serves the Hugo output in public/ with no Worker script.
// The name is the Worker's name in the Cloudflare dashboard; the two must match.
{
    "name": "miha-software",
    "compatibility_date": "2026-11-12",
    "assets": {
        "directory": "./public",
        // Unknown paths get the site's 404.html with a 404 status.
        "not_found_handling": "404-page"
    },
    // Production is served only through this route. The hostname's DNS record is a proxied
    // placeholder kept in the zone, and the zone's universal certificate covers it.
    "routes": [
        { "pattern": "www.mihasoftware.com/*", "zone_name": "mihasoftware.com" }
    ],
    "workers_dev": false,
    // Pull-request previews are served on workers.dev, behind Cloudflare Access.
    "preview_urls": true,
    "previews": {}
}
